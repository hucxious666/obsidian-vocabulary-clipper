{
  "manifest_version": 3,
  "name": "Obsidian 词汇采集器",
  "version": "1.2.0",
  "description": "双击查询英文词义，并将词汇添加到指定 Obsidian Chapter 或 NEWS 文件。",
  "key": "",
  "permissions": ["contextMenus", "nativeMessaging", "notifications", "storage"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["lib.js", "lookup-popover.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lookup-popover.css"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ],
  "action": { "default_title": "Obsidian 词汇采集器", "default_icon": "icon.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
