{
  "manifest_version": 3,
  "name": "Obsidian 词汇采集器",
  "version": "1.6.0",
  "description": "选区查询英文释义或翻译，并将单词添加到 Obsidian 自定义章节或笔记末尾。",
  "key": "",
  "permissions": ["contextMenus", "nativeMessaging", "notifications", "storage"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["lib.js", "lookup-details.js", "lookup-popover.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lookup-popover.css"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ],
  "action": {
    "default_title": "Obsidian 词汇采集器",
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
