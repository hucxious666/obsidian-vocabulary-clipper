{
  "manifest_version": 3,
  "name": "Obsidian 词汇采集器",
  "version": "1.1.0",
  "description": "从 Chrome PDF 右键添加英文词汇到指定 Obsidian Chapter 或 NEWS 文件。",
  "key": "",
  "permissions": ["contextMenus", "nativeMessaging", "notifications", "storage"],
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Obsidian 词汇采集器", "default_icon": "icon.png" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
